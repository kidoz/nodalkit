#pragma once

/// @file nk_version.h
/// @brief NodalKit project version, generated by the Meson build from
/// `meson.project_version()`. Do not edit; this file is regenerated on every
/// configure and installed alongside the `nk/` headers.

#define NK_VERSION "@NK_VERSION@"
#define NK_VERSION_MAJOR @NK_VERSION_MAJOR@
#define NK_VERSION_MINOR @NK_VERSION_MINOR@
#define NK_VERSION_PATCH @NK_VERSION_PATCH@
